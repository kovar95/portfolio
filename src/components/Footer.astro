---
import styles from './Footer.module.css';
import { useContent, localePath, PROFILE, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
const year = new Date().getFullYear();
---

<footer class={styles.footer}>
  <div class={`shell ${styles.inner}`}>
    <span>
      © {year} <span class={styles.name}>{PROFILE.name}</span> · {t.footer.rights} ·{' '}
      <a class={styles.legal} href={localePath(lang, t.legal.privacyPath)}>{t.legal.privacy}</a>
    </span>

    <span class={styles.built}>
      <span class={styles.spark} aria-hidden="true">◆</span>
      {t.footer.built}
    </span>

    <a class={styles.top} href="#main">
      <span aria-hidden="true">↑</span>
      {t.footer.top}
    </a>
  </div>
</footer>
