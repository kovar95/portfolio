---
import styles from './Hero.module.css';
import { useContent, PROFILE, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useContent(lang);
const { code } = t.hero;
const base = lang === 'en' ? '' : '/sr';
const [firstName, lastName] = PROFILE.name.split(' ');
---

<section class={styles.hero} aria-labelledby="hero-name">
  <div class={`shell ${styles.grid}`}>
    <div class={styles.intro}>
      <p class={styles.prompt}>
        <span><span class={styles.promptUser}>stefan@portfolio</span>:~$</span>
        <span class={styles.promptCmd}>whoami</span>
        <span class={styles.cursor} aria-hidden="true"></span>
      </p>

      <h1 class={styles.name} id="hero-name">
        {firstName}
        <span class={styles.nameSecond}>{lastName}</span>
      </h1>

      <p class={styles.roleRow}>
        <span class={styles.role}>{t.hero.role}</span>
        <span class={styles.dot} aria-hidden="true">//</span>
        <span class={styles.location}>{t.hero.location}</span>
      </p>

      <p class={styles.tagline}>{t.hero.tagline}</p>

      <p class={styles.status}>
        <span class={styles.pulse} aria-hidden="true"></span>
        {t.hero.status}
      </p>

      <div class={styles.ctaRow}>
        <a class={`${styles.btn} ${styles.btnPrimary}`} href={`${base}/#contact`}>
          {t.hero.primaryCta}
          <span class={styles.arrow} aria-hidden="true">→</span>
        </a>
        <a class={`${styles.btn} ${styles.btnGhost}`} href={PROFILE.cv} download>
          {t.hero.secondaryCta}
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class={styles.scrollHint} aria-hidden="true">
        <span class={styles.scrollLine}></span>
        {t.hero.scrollHint}
      </p>
    </div>

    <div class={styles.window} aria-hidden="true">
      <div class={styles.windowBar}>
        <span class={styles.lights}>
          <span class={styles.light}></span>
          <span class={styles.light}></span>
          <span class={styles.light}></span>
        </span>
        <span class={styles.fileName}>stefan.ts</span>
      </div>

      <pre class={styles.code}><code><span class={styles.ln}><span class={styles.kw}>const</span> <span class={styles.var}>stefan</span> <span class={styles.pn}>=</span> <span class={styles.pn}>&#123;</span></span><span class={styles.ln}>  <span class={styles.key}>{code.keys.role}</span><span class={styles.pn}>:</span> <span class={styles.str}>'{code.values.role}'</span><span class={styles.pn}>,</span></span><span class={styles.ln}>  <span class={styles.key}>{code.keys.location}</span><span class={styles.pn}>:</span> <span class={styles.str}>'{code.values.location}'</span><span class={styles.pn}>,</span></span><span class={styles.ln}>  <span class={styles.key}>{code.keys.stack}</span><span class={styles.pn}>: [</span><span class={styles.str}>'React'</span><span class={styles.pn}>,</span> <span class={styles.str}>'TypeScript'</span><span class={styles.pn}>,</span> <span class={styles.str}>'Astro'</span><span class={styles.pn}>],</span></span><span class={styles.ln}>  <span class={styles.key}>{code.keys.years}</span><span class={styles.pn}>:</span> <span class={styles.num}>6</span><span class={styles.pn}>,</span></span><span class={styles.ln}>  <span class={styles.key}>{code.keys.status}</span><span class={styles.pn}>:</span> <span class={styles.str}>'{code.values.status}'</span><span class={styles.pn}>,</span></span><span class={styles.ln}><span class={styles.pn}>&#125; as const;</span></span></code></pre>

      <div class={styles.windowFoot}>
        <span>TypeScript</span>
        <span class={styles.footTag}>● {PROFILE.yearsExperience} yrs</span>
      </div>
    </div>
  </div>
</section>
