{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-01",

  /**
   * Assets-only Worker: there is no `main` script, Cloudflare just serves the
   * built static site from the edge.
   *
   * not_found_handling serves our own /404.html instead of a bare Cloudflare
   * error page. html_handling defaults to "auto-trailing-slash", which is what
   * maps /sr/ to /sr/index.html.
   */
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
